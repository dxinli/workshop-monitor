# 复制为 .env 后填写。.env 不进版本库。
POSTGRES_DB=workshop_monitor
POSTGRES_USER=workshop_owner
POSTGRES_PASSWORD=

# 初始化脚本建的业务角色口令，由 01_schema.sql 用 \getenv 读取。
# 缺任一项时初始化直接失败，不建无口令的登录角色。
WORKSHOP_ADAPTER_PASSWORD=
WORKSHOP_DASHBOARD_PASSWORD=
WORKSHOP_NOTIFY_PASSWORD=
WORKSHOP_READONLY_PASSWORD=

MQTT_BROKER_URL=tcp://localhost:1883
MQTT_TOPIC_SCHEME=grid

# 边缘本地队列的三上限与补传限速（接口规范 §9.3 §9.4，附录 B）。
# 不填就用代码里的冻结值：7 天 / 30 万条 / 512 MB / 补传 500 条 · 50 ms。
# 现场若磁盘更小或链路更慢，改这里，不改代码。
CACHE_MAX_DAYS=7
CACHE_MAX_ITEMS=300000
CACHE_MAX_BYTES=536870912
CACHE_WARN_RATIO=0.8
BACKFILL_BATCH=500
BACKFILL_INTERVAL_MS=50

# Mosquitto 账号口令，由 scripts/gen-passwd.sh 生成 deploy/mosquitto/passwd。
# 账号清单的唯一来源是 deploy/mosquitto/acl.<scheme> 的 user 行，
# 变量名按账号推导：ESN-ZX-0001 → MQTT_ESN_ZX_0001_PASSWORD。
MQTT_WORKSHOP_ADAPTER_PASSWORD=
MQTT_ESN_ZX_0001_PASSWORD=
MQTT_ESN_ZX_0002_PASSWORD=
MQTT_ESN_ZX_0003_PASSWORD=
MQTT_ESN_ZX_0004_PASSWORD=
MQTT_ESN_ZX_0005_PASSWORD=

# 接入服务的通知请求目标。4.0.5 的 Node-RED 只有一个 HTTP 监听口，
# 编辑器与 /api/notify 共用 1880，没有独立的 1881。
NOTIFY_ENDPOINT=http://localhost:1880/api/notify
NOTIFY_ENABLED=true

# 自研服务的健康检查监听地址，默认只听回环。
# edge-agent 取 9101（同主机 5 实例按 9102~9105 覆盖），proto-adapter 取 9200；
# 端口分组见概要设计 §2.7。
# HEALTH_ADDR=127.0.0.1:9101
# HEALTH_ADDR=127.0.0.1:9200

# 通知通道。切换真实企业微信只改这两项，流程不变（BR-42）。
# WECOM_WEBHOOK_URL 留空不是「跳过」而是「投递失败」：Node-RED 会写一条 FAILED
# 到 notify_log 并照常给 adapter 回 202，不会静默丢。
# WECOM_ENABLED（灰度总开关）由 012 落点，当前流程尚未读取。
NOTIFY_CHANNEL=wecom-mock
WECOM_WEBHOOK_URL=http://localhost:8081/webhook

# scripts/setup-pty.sh 生成的 pty 端点写在下面这个受管区块里，勿手改：
# 键名为 PTY_<终端>_<总线>（如 PTY_ESN_ZX_0001_A），值为采集侧的 pty 端点。
# 区块随每次执行整体重写，手写的内容会被覆盖。
