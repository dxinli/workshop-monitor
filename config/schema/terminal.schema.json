{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workshop-monitor/config/terminal.schema.json",
  "title": "终端点表",
  "description": "config/terminals/ESN-ZX-000N.json 的结构约束。语义约束（V-01~V-11）由 cmd/config-tool 校验，本文件只管形状与取值范围。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "terminalId",
    "configVersion",
    "workshop",
    "line",
    "collectIntervalMs",
    "publishBatch",
    "buses"
  ],
  "properties": {
    "terminalId": {
      "type": "string",
      "pattern": "^ESN-[A-Z]{2}-[0-9]{4}$",
      "description": "即终端 ESN，全局唯一，同时是文件名前缀"
    },
    "configVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "配置版本，写入 terminal.config_version，V-12 据此判断是否记配置加载事件"
    },
    "workshop": { "type": "string", "minLength": 1 },
    "line": { "type": "string", "minLength": 1 },
    "collectIntervalMs": { "type": "integer", "minimum": 1000 },
    "publishBatch": { "type": "boolean" },
    "buses": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/bus" }
    }
  },
  "$defs": {
    "bus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "busId",
        "mode",
        "port",
        "baudRate",
        "dataBits",
        "stopBits",
        "parity",
        "timeoutMs",
        "retryCount",
        "interFrameMs",
        "devices"
      ],
      "properties": {
        "busId": { "enum": ["A", "B"] },
        "mode": { "enum": ["rtu-serial", "rtu-tcp"] },
        "port": { "type": "string", "minLength": 1 },
        "baudRate": { "type": "integer", "enum": [1200, 2400, 4800, 9600, 19200, 38400, 57600, 115200] },
        "dataBits": { "enum": [7, 8] },
        "stopBits": { "enum": [1, 2] },
        "parity": { "enum": ["N", "E", "O"] },
        "timeoutMs": { "type": "integer", "minimum": 100 },
        "retryCount": { "type": "integer", "minimum": 0, "maximum": 5 },
        "interFrameMs": { "type": "integer", "minimum": 1 },
        "devices": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/device" }
        }
      }
    },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slaveAddr", "name", "type", "blocks"],
      "properties": {
        "slaveAddr": { "type": "integer", "minimum": 1, "maximum": 247 },
        "name": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "blocks": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/block" }
        }
      }
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["functionCode", "startAddr", "registerCount", "points"],
      "properties": {
        "functionCode": { "const": 3 },
        "startAddr": { "type": "integer", "minimum": 0 },
        "registerCount": { "type": "integer", "minimum": 1, "maximum": 125 },
        "points": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/point" }
        }
      }
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "name",
        "siType",
        "dataType",
        "byteOrder",
        "addr",
        "width",
        "scale",
        "offset",
        "unit",
        "minValue",
        "maxValue"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{1,31}$",
          "description": "一经使用不得变更；展示名称用 name"
        },
        "name": { "type": "string", "minLength": 1 },
        "siType": { "enum": ["YC", "YX"] },
        "dataType": { "enum": ["int16", "uint16", "int32", "uint32"] },
        "byteOrder": { "const": "AB" },
        "addr": {
          "type": "integer",
          "minimum": 0,
          "description": "块内偏移，不是绝对寄存器地址"
        },
        "width": { "enum": [1, 2] },
        "scale": { "type": "number" },
        "offset": { "type": "number" },
        "unit": { "type": ["string", "null"], "description": "遥信无单位时允许 null" },
        "minValue": { "type": "number" },
        "maxValue": { "type": "number" }
      }
    }
  }
}