{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workshop-monitor/config/thresholds.schema.json",
  "title": "告警阈值",
  "description": "config/thresholds.json 的结构约束。规则按「终端 × 总线 × 测点」展开成 threshold 表行；语义约束见 V-11。",
  "type": "object",
  "additionalProperties": false,
  "required": ["configVersion", "rules"],
  "properties": {
    "configVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/rule" }
    }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "pointCodes",
        "alarmType",
        "operator",
        "thresholdValue",
        "level",
        "debounceCount",
        "terminalId",
        "busId"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^TH-[0-9]{2}$",
          "description": "规则编号，与接口规范 §11.1 的 TH-01~TH-15 对应"
        },
        "pointCodes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,31}$" }
        },
        "alarmType": {
          "enum": [
            "HIGH_LIMIT",
            "HIGH_HIGH_LIMIT",
            "LOW_LIMIT",
            "STATE_ALARM",
            "SENSOR_OFFLINE",
            "TERMINAL_OFFLINE",
            "CACHE_WARNING",
            "DATA_QUALITY_ERROR"
          ]
        },
        "operator": { "enum": [">", ">=", "<", "<="] },
        "thresholdValue": { "type": ["number", "null"] },
        "level": { "type": "integer", "minimum": 1, "maximum": 4 },
        "debounceCount": {
          "type": "integer",
          "minimum": 0,
          "description": "0 表示开关量不去抖"
        },
        "terminalId": {
          "type": "string",
          "description": "空串表示适用全部终端"
        },
        "busId": {
          "enum": ["", "A", "B"],
          "description": "空串表示适用该终端全部总线"
        }
      }
    }
  }
}