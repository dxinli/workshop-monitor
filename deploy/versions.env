# 镜像标签唯一来源。改这里要同步 deploy/docker-compose.yml 与文档。
MOSQUITTO_VERSION=2.0.20
TIMESCALEDB_VERSION=2.17.2-pg16
NODE_RED_VERSION=4.0.5
# Node-RED 的 PostgreSQL 节点。官方镜像不带数据库节点，N-02 写投递日志要用它。
NODE_RED_PG_NODE_VERSION=0.16.2
# Node-RED 写视图面板插件。官方镜像不带，N-04 的按钮与表格靠它。
NODE_RED_DASHBOARD_VERSION=1.34.1
# 通知接收端 sim/wecom-mock 的基础镜像。仿真件，只进 sim profile，不进交付镜像。
PYTHON_SIM_VERSION=3.12.7-slim-bookworm
GRAFANA_VERSION=11.3.0
SOCAT_VERSION=1.8.0.0
