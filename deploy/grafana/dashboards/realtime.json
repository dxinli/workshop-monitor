      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "workshop-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT terminal_id AS \"终端\", workshop AS \"车间\", device_name AS \"设备\",\n                         point_name AS \"测点\", point_id AS \"测点编码\",\n                         value AS \"数值\", unit AS \"单位\",\n                         collect_time AS \"采集时间\", seq AS \"序号\",\n                         CASE quality WHEN 0 THEN '正常' WHEN 1 THEN '设备异常' WHEN 2 THEN '通信超时'\n            WHEN 3 THEN '校验错误' WHEN 4 THEN '解析错误' WHEN 5 THEN '超量程'\n            WHEN 6 THEN '数据陈旧' WHEN 7 THEN '仿真数据' WHEN 8 THEN '人工注入'\n            ELSE '未知(' || quality || ')' END AS \"质量\",\n                         CASE WHEN is_stale THEN '超时未更新' ELSE '正常刷新' END AS \"刷新\"\n                  FROM v_realtime\n                  WHERE workshop IN (${workshop:sqlstring}) AND terminal_id IN (${esn:sqlstring}) AND point_id IN (${point:sqlstring})\n                  ORDER BY terminal_id, device_name, point_name"
        }
      ],
