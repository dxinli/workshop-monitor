    {
      "id": 1,
      "type": "table",
      "title": "实时值",
      "description": "只显示采集时间最新的值。质量非正常时数值为空，不沿用上一次读数。",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "workshop-pg"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 0
