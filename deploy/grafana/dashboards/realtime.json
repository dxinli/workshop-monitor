      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "workshop-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT DISTINCT ON (m.terminal_id, m.point_id)\n                         m.terminal_id AS \"终端\", d.point_name AS \"测点\", m.point_id AS \"测点编码\",\n                         d.unit AS \"单位\", m.value AS \"最近一次正常值\",\n                         m.collect_time AS \"采集时间\", CASE m.quality WHEN 0 THEN '正常' WHEN 1 THEN '设备异常' WHEN 2 THEN '通信超时'\n            WHEN 3 THEN '校验错误' WHEN 4 THEN '解析错误' WHEN 5 THEN '超量程'\n            WHEN 6 THEN '数据陈旧' WHEN 7 THEN '仿真数据' WHEN 8 THEN '人工注入'\n            ELSE '未知(' || m.quality || ')' END AS \"质量\"\n                  FROM measurement m JOIN v_point_dict d\n                    ON d.terminal_id = m.terminal_id AND d.point_id = m.point_id\n                  WHERE $__timeFilter(m.collect_time) AND m.quality = 0\n                    AND d.workshop IN (${workshop:sqlstring}) AND m.terminal_id IN (${esn:sqlstring}) AND m.point_id IN (${point:sqlstring})\n                  ORDER BY m.terminal_id, m.point_id, m.collect_time DESC"
        }
      ],
