    {
      "id": 6,
      "type": "table",
      "title": "历史告警",
      "description": "按发生时间倒序，时间范围由面板顶部传入。",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "workshop-pg"
