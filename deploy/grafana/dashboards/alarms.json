    {
      "id": 5,
      "type": "table",
      "title": "活动告警",
      "description": "已发生且尚未恢复，按级别与发生时间倒序。活动告警不受时间范围限制。",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "workshop-pg"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "workshop-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT a.terminal_id AS \"终端\", t.workshop AS \"车间\", a.device_name AS \"设备\",\n                        a.point_name AS \"测点\", CASE a.alarm_type WHEN 'HIGH_LIMIT' THEN '高限' WHEN 'HIGH_HIGH_LIMIT' THEN '高高限'\n            WHEN 'LOW_LIMIT' THEN '低限' WHEN 'STATE_ALARM' THEN '状态报警'\n            WHEN 'SENSOR_OFFLINE' THEN '传感器离线' WHEN 'TERMINAL_OFFLINE' THEN '终端离线'\n            WHEN 'CACHE_WARNING' THEN '缓存预警' WHEN 'DATA_QUALITY_ERROR' THEN '数据质量异常'\n            ELSE a.alarm_type END AS \"告警类型\", CASE a.level WHEN 1 THEN '提示' WHEN 2 THEN '警告' WHEN 3 THEN '严重' WHEN 4 THEN '紧急'\n           ELSE a.level::text END AS \"级别\",\n                        a.occur_time AS \"发生时间\", a.last_time AS \"最近发生\",\n                        a.trigger_value AS \"触发值\", a.point_unit AS \"单位\", a.trigger_count AS \"次数\",\n                        a.message AS \"告警说明\",\n                        CASE WHEN a.acked_time IS NULL THEN '未确认' ELSE '已确认' END AS \"确认\",\n                        a.acked_by AS \"确认人\", a.acked_time AS \"确认时间\"\n                 FROM v_alarm_active a JOIN terminal t ON t.terminal_id = a.terminal_id\n                 WHERE t.workshop IN (${workshop:sqlstring})\n                 ORDER BY a.level DESC, a.occur_time DESC\n                 LIMIT 200"
        }
      ],
