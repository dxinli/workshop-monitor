      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "workshop-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT a.terminal_id AS \"终端\", t.workshop AS \"车间\", d.device_name AS \"设备\",\n                         d.point_name AS \"测点\", CASE a.alarm_type WHEN 'HIGH_LIMIT' THEN '高限' WHEN 'HIGH_HIGH_LIMIT' THEN '高高限'\n            WHEN 'LOW_LIMIT' THEN '低限' WHEN 'STATE_ALARM' THEN '状态报警'\n            WHEN 'SENSOR_OFFLINE' THEN '传感器离线' WHEN 'TERMINAL_OFFLINE' THEN '终端离线'\n            WHEN 'CACHE_WARNING' THEN '缓存预警' WHEN 'DATA_QUALITY_ERROR' THEN '数据质量异常'\n            ELSE a.alarm_type END AS \"告警类型\", CASE a.level WHEN 1 THEN '提示' WHEN 2 THEN '警告' WHEN 3 THEN '严重' WHEN 4 THEN '紧急'\n           ELSE a.level::text END AS \"级别\",\n                         a.occur_time AS \"发生时间\", a.recover_time AS \"恢复时间\",\n                         a.trigger_value AS \"触发值\", d.unit AS \"单位\",\n                         CASE a.status WHEN 'ACTIVE' THEN '活动' WHEN 'RECOVERED' THEN '已恢复'\n                              WHEN 'ACKED' THEN '已确认' WHEN 'CLOSED' THEN '已归档'\n                              ELSE a.status END AS \"状态\",\n                         a.message AS \"告警说明\"\n                  FROM v_alarm_history a\n                  JOIN terminal t ON t.terminal_id = a.terminal_id\n                  LEFT JOIN v_point_dict d\n                    ON d.terminal_id = a.terminal_id AND d.point_id = a.point_id\n                  WHERE $__timeFilter(a.occur_time) AND t.workshop IN (${workshop:sqlstring})\n                  ORDER BY a.occur_time DESC\n                  LIMIT 2000"
        }
      ],
