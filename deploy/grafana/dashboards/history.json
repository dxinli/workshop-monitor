{
  "uid": "workshop-history",
  "title": "历史曲线",
  "description": "单测点或多测点的历史趋势与数据导出。",
  "tags": [
    "车间监测",
    "读视图"
  ],
  "timezone": "Asia/Shanghai",
  "refresh": "5s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m"
    ],
    "time_options": [
      "1h",
      "24h",
      "7d",
      "30d"
    ]
  },
  "templating": {
    "list": [
      {
        "name": "workshop",
        "label": "车间",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "workshop-pg"
        },
        "query": "SELECT DISTINCT workshop AS __text, workshop AS __value FROM v_point_dict ORDER BY 1",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "hide": 0,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "esn",
        "label": "终端",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "workshop-pg"
        },
        "query": "SELECT DISTINCT terminal_id AS __text, terminal_id AS __value FROM v_point_dict WHERE workshop IN (${workshop:sqlstring}) ORDER BY 1",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "hide": 0,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "point",
        "label": "测点",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "workshop-pg"
        },
        "query": "SELECT point_name || '（' || point_id || '）' AS __text, point_id AS __value FROM v_point_dict WHERE terminal_id IN (${esn:sqlstring}) ORDER BY 2",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "hide": 0,
        "current": {
          "selected": true,
          "text": [
            "电机绕组温度（A.1.motor_temp）"
          ],
          "value": [
            "A.1.motor_temp"
          ]
        }
      }
    ]
  },
