  "editable": false,
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "历史曲线",
      "description": "横轴为采集时间。时间范围 ≤ 24 小时查明细，> 24 小时查分钟聚合。",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "workshop-pg"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "workshop-pg"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT * FROM (\nSELECT collect_time AS time, point_id AS metric, value\n        FROM measurement\n        WHERE $__timeFilter(collect_time) AND terminal_id IN (${esn:sqlstring}) AND point_id IN (${point:sqlstring}) AND (SELECT EXTRACT(EPOCH FROM ($__timeTo()::timestamptz - $__timeFrom()::timestamptz))) <= 86400\nUNION ALL\nSELECT time_bucket(GREATEST('$__interval'::interval, interval '1 minute'), bucket) AS time,\n               point_id AS metric, avg(avg_value) AS value\n        FROM measurement_1m\n        WHERE $__timeFilter(bucket) AND terminal_id IN (${esn:sqlstring}) AND point_id IN (${point:sqlstring}) AND (SELECT EXTRACT(EPOCH FROM ($__timeTo()::timestamptz - $__timeFrom()::timestamptz))) > 86400\n        GROUP BY 1, 2\n) s\nORDER BY time LIMIT 2000"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true,
            "axisPlacement": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "min",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 2,
      "type": "text",
      "title": "选源口径",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "workshop-pg"
      },
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 10
      },
      "options": {
        "mode": "markdown",
        "code": {
          "language": "plaintext",
          "showLineNumbers": false,
          "showMiniMap": false
        },
        "content": "**曲线**：时间范围 ≤ 24 小时查明细表；> 24 小时查分钟聚合表。\n\n**导出**：明细表，时间范围需 ≤ 24 小时，单次上限 20 万行。用面板右上角 Inspect → Data → Download CSV 导出。\n\n明细保留 7 天，分钟聚合保留 30 天。选择 30 天时曲线按分钟聚合精度展示。"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "table",
      "title": "数据明细（可导出 CSV）",
      "description": "列顺序按接口规范 §13.2。value 为空表示该次采集质量非正常，导出为空串而不是 0。",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "workshop-pg"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "workshop-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT m.terminal_id AS \"terminalId\", d.workshop AS \"workshop\",\n                         m.bus_id AS \"busId\", m.slave_addr AS \"slaveAddr\",\n                         m.point_code AS \"pointCode\", d.point_name AS \"pointName\",\n                         m.si_type AS \"siType\", m.value AS \"value\", d.unit AS \"unit\",\n                         m.quality AS \"quality\",\n                         to_char(m.collect_time AT TIME ZONE 'Asia/Shanghai', 'YYYY-MM-DD HH24:MI:SS.MS') AS \"collectTime\",\n                         to_char(m.send_time AT TIME ZONE 'Asia/Shanghai', 'YYYY-MM-DD HH24:MI:SS.MS') AS \"sendTime\",\n                         m.backfill AS \"backfill\"\n                  FROM measurement m JOIN v_point_dict d\n                    ON d.terminal_id = m.terminal_id AND d.point_id = m.point_id\n                  WHERE $__timeFilter(m.collect_time) AND d.workshop IN (${workshop:sqlstring}) AND m.terminal_id IN (${esn:sqlstring}) AND m.point_id IN (${point:sqlstring})\n                    AND (SELECT EXTRACT(EPOCH FROM ($__timeTo()::timestamptz - $__timeFrom()::timestamptz))) <= 86400\n                  ORDER BY m.collect_time DESC\n                  LIMIT 200000"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false,
            "filterable": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "采集时间"
            },
            "properties": [
              {
                "id": "unit",
