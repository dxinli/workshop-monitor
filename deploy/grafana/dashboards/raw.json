              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "解析结果"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "已解析": {
                        "text": "已解析",
                        "color": "green",
                        "index": 0
                      },
                      "重复报文": {
                        "text": "重复报文",
                        "color": "blue",
                        "index": 1
                      },
                      "解析失败": {
                        "text": "解析失败",
                        "color": "red",
                        "index": 2
                      },
                      "标识不符": {
                        "text": "标识不符",
                        "color": "orange",
