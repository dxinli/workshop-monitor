        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "workshop-pg"
        },
        "query": "SELECT '已解析' AS __text, 'OK' AS __value UNION ALL SELECT '重复报文', 'DUPLICATE' UNION ALL SELECT '解析失败', 'PARSE_ERROR' UNION ALL SELECT '标识不符', 'IDENTITY_MISMATCH'",
