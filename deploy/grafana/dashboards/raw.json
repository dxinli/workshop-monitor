                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        },
        "sortBy": []
      }
    },
    {
      "id": 2,
      "type": "text",
      "title": "字段说明",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "workshop-pg"
      },
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "options": {
        "mode": "markdown",
        "code": {
          "language": "plaintext",
          "showLineNumbers": false,
          "showMiniMap": false
        },
        "content": "解析结果：已解析＝正常入库；重复报文＝幂等命中；解析失败＝字段或格式不符；标识不符＝报文终端标识与主题不一致。\n\n报文保留 7 天，原文完整保存不裁剪。序号用于跨终端核对补传顺序。"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      }
