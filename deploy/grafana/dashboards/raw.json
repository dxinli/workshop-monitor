            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTime:YYYY-MM-DD HH:mm:ss.SSS"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "collectTime"
            },
            "properties": [
              {
                "id": "unit",
