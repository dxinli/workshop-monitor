  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "原始报文",
      "description": "平台收到的报文原文，保留 7 天。时间轴为接收时间，仅供排查链路，不参与业务判定。",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "workshop-pg"
      },
      "gridPos": {
        "h": 16,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "workshop-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT receive_time AS \"接收时间\", terminal_id AS \"终端\", topic AS \"主题\",\n                         seq AS \"序号\", CASE parse_status WHEN 'OK' THEN '已解析' WHEN 'DUPLICATE' THEN '重复报文'\n            WHEN 'PARSE_ERROR' THEN '解析失败' WHEN 'IDENTITY_MISMATCH' THEN '标识不符'\n            ELSE parse_status END AS \"解析结果\", fail_reason AS \"失败原因\",\n                         payload_bytes AS \"字节数\", payload AS \"报文原文\"\n                  FROM raw_message\n                  WHERE $__timeFilter(receive_time)\n                    AND terminal_id IN (${esn:sqlstring})\n                    AND parse_status IN (${parse_status:sqlstring})\n                    AND ('${seq:raw}' = '' OR seq = NULLIF('${seq:raw}', '')::bigint)\n                  ORDER BY receive_time DESC\n                  LIMIT 1000"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false,
            "filterable": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "采集时间"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTime:YYYY-MM-DD HH:mm:ss.SSS"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "最后数据时间"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTime:YYYY-MM-DD HH:mm:ss.SSS"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "最后在线时间"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTime:YYYY-MM-DD HH:mm:ss.SSS"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "发生时间"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTime:YYYY-MM-DD HH:mm:ss.SSS"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "最近发生"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTime:YYYY-MM-DD HH:mm:ss.SSS"
              }
            ]
          },
          {
