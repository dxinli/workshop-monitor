      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "workshop-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT round(sum(v)::numeric, 2) AS value FROM (SELECT * FROM (\nSELECT avg(m.value) AS v\n                   FROM measurement m JOIN v_point_dict d\n                     ON d.terminal_id = m.terminal_id AND d.point_id = m.point_id\n                   WHERE $__timeFilter(m.collect_time) AND d.point_code = 'p_total'\n                     AND m.quality = 0 AND d.workshop IN (${workshop:sqlstring}) AND (SELECT EXTRACT(EPOCH FROM ($__timeTo()::timestamptz - $__timeFrom()::timestamptz))) <= 86400\nUNION ALL\nSELECT avg(x.avg_value) AS v\n                FROM measurement_1m x JOIN v_point_dict d\n                  ON d.terminal_id = x.terminal_id AND d.point_id = x.point_id\n                WHERE $__timeFilter(x.bucket) AND d.point_code = 'p_total'\n                  AND d.workshop IN (${workshop:sqlstring}) AND (SELECT EXTRACT(EPOCH FROM ($__timeTo()::timestamptz - $__timeFrom()::timestamptz))) > 86400\n) s) t"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "kwatt",
          "decimals": 2,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "auto",
        "showPercentChange": false,
        "wideLayout": true
      }
    },
    {
      "id": 7,
      "type": "table",
      "title": "终端一览",
      "description": "状态为三源合成结论；最后数据时间为最近一次非补传上报的采集时间。",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "workshop-pg"
      },
      "gridPos": {
        "h": 9,
        "w": 14,
        "x": 0,
        "y": 5
