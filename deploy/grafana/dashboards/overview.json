          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT t.workshop AS \"车间\", count(a.alarm_id) AS \"活动告警\"\n                 FROM terminal t\n                 LEFT JOIN alarm a ON a.terminal_id = t.terminal_id AND a.status = 'ACTIVE'\n                 WHERE t.workshop IN (${workshop:sqlstring})\n                 GROUP BY 1 ORDER BY 1"
        }
