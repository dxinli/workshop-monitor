        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "workshop-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT terminal_id AS \"终端\", workshop AS \"车间\", line AS \"产线\",\n                         CASE status WHEN 'ONLINE' THEN '在线' WHEN 'OFFLINE' THEN '离线' ELSE '未知' END AS \"状态\",\n                         last_data_time AS \"最后数据时间\", last_seen_time AS \"最后在线时间\",\n                         active_alarm_count AS \"活动告警数\",\n                         CASE WHEN enabled THEN '启用' ELSE '停用' END AS \"启用\"\n                  FROM v_terminal_overview\n                  WHERE workshop IN (${workshop:sqlstring})\n                  ORDER BY workshop, terminal_id"
        }
      ],
