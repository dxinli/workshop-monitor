    {
      "id": 5,
      "type": "stat",
      "title": "窗口电能消耗",
      "description": "正向有功电能：每个测点取窗口末值减首值，再汇总。累计量不能求和。",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "workshop-pg"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 16,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "workshop-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT round(sum(v)::numeric, 2) AS value FROM (SELECT * FROM (\nSELECT s.workshop AS metric, sum(s.delta) AS v\n                    FROM (SELECT m.terminal_id, m.point_id, d.workshop,\n                                 max(m.value) - min(m.value) AS delta\n                          FROM measurement m JOIN v_point_dict d\n                            ON d.terminal_id = m.terminal_id AND d.point_id = m.point_id\n                          WHERE $__timeFilter(m.collect_time) AND d.point_code = 'ep_forward'\n                            AND m.quality = 0 AND d.workshop IN (${workshop:sqlstring}) AND (SELECT EXTRACT(EPOCH FROM ($__timeTo()::timestamptz - $__timeFrom()::timestamptz))) <= 86400\n                          GROUP BY 1, 2, 3) s\n                    GROUP BY 1\nUNION ALL\nSELECT s.workshop AS metric, sum(s.delta) AS v\n                 FROM (SELECT x.terminal_id, x.point_id, d.workshop,\n                              max(x.max_value) - min(x.min_value) AS delta\n                       FROM measurement_1m x JOIN v_point_dict d\n                         ON d.terminal_id = x.terminal_id AND d.point_id = x.point_id\n                       WHERE $__timeFilter(x.bucket) AND d.point_code = 'ep_forward'\n                         AND d.workshop IN (${workshop:sqlstring}) AND (SELECT EXTRACT(EPOCH FROM ($__timeTo()::timestamptz - $__timeFrom()::timestamptz))) > 86400\n                       GROUP BY 1, 2, 3) s\n                 GROUP BY 1\n) s) t"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "kwatth",
          "decimals": 2,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "auto",
        "showPercentChange": false,
        "wideLayout": true
      }
    },
