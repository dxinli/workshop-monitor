    {
      "id": 4,
      "type": "stat",
      "title": "设备健康度",
      "description": "时间范围内正常质量（质量码 0）读数占比，走分钟聚合。",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "workshop-pg"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "workshop-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT round(100.0 * sum(good_count) / NULLIF(sum(total_count), 0), 1) AS value\n                 FROM measurement_1m WHERE $__timeFilter(bucket) AND si_type = 'YC'"
        }
      ],
      "fieldConfig": {
