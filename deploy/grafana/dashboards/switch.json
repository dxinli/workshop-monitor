    {
      "id": 1,
      "type": "table",
      "title": "开关量状态",
      "description": "门磁、急停、光幕为二值状态，不做去抖。「异常」列 1 表示现场安全信号触发。",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "workshop-pg"
      },
      "gridPos": {
        "h": 11,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "workshop-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT r.terminal_id AS \"终端\", r.workshop AS \"车间\", r.device_name AS \"设备\",\n                         r.point_name AS \"测点\",\n                         CASE WHEN r.value IS NULL THEN '无数据'\n                              WHEN r.value = 0 THEN CASE d.point_code\n                                  WHEN 'door' THEN '闭合' WHEN 'estop' THEN '正常'\n                                  WHEN 'light_curtain' THEN '通光' ELSE '断开' END\n                              ELSE CASE d.point_code\n                                  WHEN 'door' THEN '打开' WHEN 'estop' THEN '按下'\n                                  WHEN 'light_curtain' THEN '遮挡' ELSE '闭合' END\n                         END AS \"状态\",\n                         CASE WHEN r.value IS NULL THEN NULL WHEN r.value = 0 THEN 0 ELSE 1 END AS \"异常\",\n                         r.collect_time AS \"采集时间\", r.seq AS \"序号\", CASE r.quality WHEN 0 THEN '正常' WHEN 1 THEN '设备异常' WHEN 2 THEN '通信超时'\n            WHEN 3 THEN '校验错误' WHEN 4 THEN '解析错误' WHEN 5 THEN '超量程'\n            WHEN 6 THEN '数据陈旧' WHEN 7 THEN '仿真数据' WHEN 8 THEN '人工注入'\n            ELSE '未知(' || r.quality || ')' END AS \"质量\"\n                  FROM v_realtime r JOIN v_point_dict d\n                    ON d.terminal_id = r.terminal_id AND d.point_id = r.point_id\n                  WHERE r.si_type = 'YX' AND r.workshop IN (${workshop:sqlstring})\n                  ORDER BY r.terminal_id, r.device_name, r.point_name"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false,
            "filterable": false
